# OXCA MCP Hub — durcissement de base.
# En cas d'erreur 500 sur un hébergement très restrictif, voir la section
# « Dépannage » du README (AllowOverride).

Options -Indexes

# config.php ne doit jamais être servi directement (défense en profondeur :
# le fichier ne fait que définir des constantes et n'affiche rien).
<FilesMatch "^(config\.php|config\.sample\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Transmet l'en-tête Authorization à PHP (utile pour « Bearer » sur mcp.php).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
